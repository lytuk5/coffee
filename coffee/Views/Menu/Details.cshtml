@model MenuDetailsViewModel
@{
    var item = Model.Item;
    ViewData["Title"] = item.Name;
    var category = CafeDuaHau.Data.MenuData.Categories.FirstOrDefault(category => category.Id == item.CategoryId);
}

<section class="view">
    <a class="btn-secondary" asp-action="Index" asp-route-category="@category?.Id">Về thực đơn</a>
    <div class="menu-detail">
        <div data-menu-gallery>
            <div class="menu-detail-image">
                <img class="menu-detail-photo" data-gallery-main src="@Model.Photos[0]" alt="@item.Name"
                 onerror="this.onerror=null;this.src='/images/menu/placeholder.svg'" />
                <partial name="_Badges" model="item" />
            </div>
            @if (Model.Photos.Count > 1)
            {
                <div class="menu-thumbnails" role="group" aria-label="Ảnh món">
                    @for (var index = 0; index < Model.Photos.Count; index++)
                    {
                        <button type="button" data-gallery-photo="@Model.Photos[index]"
                                aria-label="Xem ảnh @(index + 1)" aria-pressed="@(index == 0 ? "true" : "false")">
                            <img src="@Model.Photos[index]" alt="" loading="lazy" />
                        </button>
                    }
                </div>
            }
        </div>
        <div class="menu-detail-info">
            @if (category is not null)
            {
                <p>@category.Name</p>
            }
            <h2>@item.Name</h2>
            <p>@item.Description</p>
            <p><strong>@(item.IsSoldOut ? "Hết hàng" : "Còn hàng")</strong></p>

            @if (item.HasSizes)
            {
                <ul class="menu-size-prices">
                    @foreach (var size in item.Sizes.OrderBy(size => size.Label))
                    {
                        <li>
                            <span>Size @size.Label</span>
                            <partial name="_Price" model="@((size.Price, item.SalePrice(size.Price), ""))" />
                        </li>
                    }
                </ul>
            }
            else
            {
                <partial name="_Price" model="@((item.Price, item.SalePrice(item.Price), ""))" />
            }
            @if (!item.IsSoldOut)
            {
                <form class="admin-form menu-detail-form" method="post" asp-controller="Cart" asp-action="Add">
                    <input type="hidden" name="itemId" value="@item.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    @if (item.HasSizes)
                    {
                        <label for="size">Kích cỡ và giá</label>
                        <select id="size" name="size">
                            @foreach (var size in item.Sizes.OrderBy(size => size.Label == "M" ? 0 : 1))
                            {
                                <option value="@size.Label">@size.Label — @Money.Format(item.SalePrice(size.Price))</option>
                            }
                        </select>
                    }
                    <label for="quantity">Số lượng</label>
                    <input id="quantity" type="number" name="quantity" value="1" min="1" max="99" required />
                    <label for="note">Ghi chú</label>
                    <textarea id="note" name="note" maxlength="200"></textarea>
                    <div class="admin-actions">
                        <button class="btn-primary" name="buyNow" value="false">Thêm vào giỏ</button>
                        <button class="btn-secondary" name="buyNow" value="true">Mua ngay</button>
                    </div>
                </form>
            }
        </div>
    </div>
</section>

<section class="view menu-reviews" id="reviews">
    <h2>Đánh giá món</h2>
    @if (Model.CanReview)
    {
        <form method="post" asp-action="Review" asp-route-id="@item.Id" class="admin-form menu-detail-form">
            <label for="rating">Số sao</label>
            <select id="rating" name="Rating" required>
                <option value="">Chọn số sao</option>
                @for (var rating = 5; rating >= 1; rating--)
                {
                    <option value="@rating">@rating sao</option>
                }
            </select>
            <label for="comment">Nhận xét</label>
            <textarea id="comment" name="Comment" maxlength="1000" required></textarea>
            <button class="btn-primary">Gửi đánh giá</button>
        </form>
    }
    @if (Model.Reviews.Count == 0)
    {
        <p>Chưa có đánh giá.</p>
    }
    @foreach (var review in Model.Reviews)
    {
        <article class="menu-review">
            <p><strong>@review.UserName</strong> · @review.Rating/5 sao · @review.CreatedAt.ToString("dd/MM/yyyy")</p>
            <p class="menu-review-comment">@review.Comment</p>
        </article>
    }
</section>
