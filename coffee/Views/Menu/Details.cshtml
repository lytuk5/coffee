@model MenuDetailsViewModel
@{
    var item = Model.Item;
    ViewData["Title"] = item.Name;
    var categoryName = ViewData["CategoryName"] as string;
    var ratingCounts = Model.Reviews.GroupBy(review => review.Rating)
        .ToDictionary(group => group.Key, group => group.Count());
    var maxRatingCount = Math.Max(1, ratingCounts.Values.DefaultIfEmpty().Max());
    var visibleReviews = Model.Reviews.Where(review => !Model.SelectedRating.HasValue ||
        review.Rating == Model.SelectedRating).ToList();
}

<section class="view">
    <a class="btn-secondary" asp-action="Index" asp-route-category="@item.CategoryId">Về thực đơn</a>
    <div class="menu-detail">
        <div data-menu-gallery>
            <div class="menu-detail-image">
                <img class="menu-detail-photo" data-gallery-main src="@Model.Photos[0]" alt="@item.Name"
                 onerror="this.onerror=null;this.src='/images/menu/placeholder.svg'" />
                <partial name="_Badges" model="item" />
            </div>
            @if (Model.Photos.Count > 1)
            {
                <div class="menu-thumbnails" role="group" aria-label="Ảnh món">
                    @for (var index = 0; index < Model.Photos.Count; index++)
                    {
                        <button type="button" data-gallery-photo="@Model.Photos[index]"
                                aria-label="Xem ảnh @(index + 1)" aria-pressed="@(index == 0 ? "true" : "false")">
                            <img src="@Model.Photos[index]" alt="" loading="lazy" />
                        </button>
                    }
                </div>
            }
        </div>
        <div class="menu-detail-info">
            @if (categoryName is not null)
            {
                <p>@categoryName</p>
            }
            <h2>@item.Name</h2>
            <p>@item.Description</p>
            <p><strong>@(item.IsSoldOut ? "Hết hàng" : "Còn hàng")</strong></p>

            @if (item.HasSizes)
            {
                <ul class="menu-size-prices">
                    @foreach (var size in item.Sizes.OrderBy(size => size.Label))
                    {
                        <li>
                            <span>Size @size.Label</span>
                            <partial name="_Price" model="@((size.Price, item.SalePrice(size.Price), ""))" />
                        </li>
                    }
                </ul>
            }
            else
            {
                <partial name="_Price" model="@((item.Price, item.SalePrice(item.Price), ""))" />
            }
            @if (!item.IsSoldOut)
            {
                <form class="admin-form menu-detail-form" method="post" asp-controller="Cart" asp-action="Add">
                    <input type="hidden" name="itemId" value="@item.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <label for="size">Chọn size</label>
                    <select id="size" name="size" required data-order-size>
                        <option value="">Chọn size</option>
                        @if (item.HasSizes)
                        {
                            @foreach (var size in item.Sizes.OrderBy(size => size.Label == "M" ? 0 : size.Label == "L" ? 1 : 2))
                            {
                                <option value="@size.Label" data-price="@Money.Format(item.SalePrice(size.Price))">@size.Label — @Money.Format(item.SalePrice(size.Price))</option>
                            }
                        }
                        else
                        {
                            <option value="M" data-price="@Money.Format(item.SalePrice(item.Price))">M — @Money.Format(item.SalePrice(item.Price))</option>
                        }
                    </select>
                    <p data-order-size-price role="status">Vui lòng chọn size</p>
                    <label for="quantity">Số lượng</label>
                    <input id="quantity" type="number" name="quantity" value="1" min="1" max="99" required />
                    <label for="note">Ghi chú</label>
                    <textarea id="note" name="note" maxlength="200"></textarea>
                    <div class="admin-actions">
                        <button class="btn-primary" name="buyNow" value="false">Thêm vào giỏ</button>
                        <button class="btn-secondary" name="buyNow" value="true">Mua ngay</button>
                    </div>
                </form>
            }
        </div>
    </div>
</section>

<section class="view menu-reviews" id="reviews">
    <h2>Đánh giá món</h2>
    @if (Model.Reviews.Count > 0)
    {
        <partial name="_RatingSummary" model="@((Model.Reviews.Average(review => review.Rating), Model.Reviews.Count))" />
    }
    <div class="review-overview">
        <div class="review-breakdown" role="group" aria-label="Số lượt theo mức sao">
            @for (var stars = 5; stars >= 1; stars--)
            {
                var count = ratingCounts.GetValueOrDefault(stars);
                <div class="review-breakdown-row">
                    <span>@stars sao</span>
                    <meter min="0" max="@maxRatingCount" value="@count" aria-hidden="true"></meter>
                    <span class="review-breakdown-count">@count</span>
                </div>
            }
        </div>
        <details class="review-filter">
            <summary class="btn-secondary">@(Model.SelectedRating is int rating ? $"Lọc · {rating} sao" : "Lọc")</summary>
            <nav class="review-filter-options" aria-label="Lọc đánh giá theo số sao">
                <a asp-action="Details" asp-route-id="@item.Id" asp-fragment="reviews"
                   aria-current="@(!Model.SelectedRating.HasValue ? "true" : null)">Tất cả đánh giá</a>
                @for (var stars = 5; stars >= 1; stars--)
                {
                    <a asp-action="Details" asp-route-id="@item.Id" asp-route-rating="@stars" asp-fragment="reviews"
                       aria-current="@(Model.SelectedRating == stars ? "true" : null)">@stars sao</a>
                }
            </nav>
        </details>
    </div>
    @if (Model.CanReview)
    {
        <form method="post" asp-action="Review" asp-route-id="@item.Id" class="admin-form menu-detail-form">
            <partial name="_StarRating" model="0" />
            <label for="comment">Nhận xét</label>
            <textarea id="comment" name="Comment" maxlength="1000" required></textarea>
            <button class="btn-primary">Gửi đánh giá</button>
        </form>
    }
    @if (visibleReviews.Count == 0)
    {
        <p>@(Model.SelectedRating.HasValue ? $"Chưa có đánh giá {Model.SelectedRating} sao." : "Chưa có đánh giá.")</p>
    }
    @foreach (var review in visibleReviews)
    {
        <article class="menu-review">
            <p class="menu-review-meta">
                <strong>@review.UserName</strong>
                <span class="menu-review-stars" role="img" aria-label="@review.Rating trên 5 sao">
                    <span class="star-selected" aria-hidden="true">@(new string('★', review.Rating))</span><span class="star-unselected" aria-hidden="true">@(new string('★', 5 - review.Rating))</span>
                </span>
                <time datetime="@review.CreatedAt.ToString("yyyy-MM-dd")">@review.CreatedAt.ToString("dd/MM/yyyy")</time>
            </p>
            <p class="menu-review-comment">@review.Comment</p>
            @{
                var isOwner = (Guid?)ViewData["ReviewCustomerId"] == review.CustomerAccountId;
            }
            @if (isOwner || User.IsInRole("Admin"))
            {
                <div class="menu-review-actions">
                    @if (isOwner)
                    {
                        <details class="menu-review-edit-toggle">
                            <summary class="btn-secondary" aria-controls="edit-review-form">Sửa đánh giá</summary>
                        </details>
                    }
                    <form method="post" asp-action="DeleteReview" asp-route-id="@item.Id" asp-route-authorId="@review.CustomerAccountId">
                        <button type="submit" class="btn-secondary" data-confirm="Bạn có chắc muốn xóa đánh giá này?">Xóa đánh giá</button>
                    </form>
                </div>
            }
            @if (isOwner)
            {
                <form id="edit-review-form" method="post" asp-action="EditReview" asp-route-id="@item.Id" class="admin-form menu-detail-form">
                    <partial name="_StarRating" model="review.Rating" />
                    <label for="edit-review-comment">Nhận xét</label>
                    <textarea id="edit-review-comment" name="Comment" maxlength="1000" required>@review.Comment</textarea>
                    <button class="btn-primary">Lưu đánh giá</button>
                </form>
            }
        </article>
    }
</section>
