@model ResetPasswordForm
<div data-account-content data-title="Đặt mật khẩu mới">
    <form data-account-form method="post" asp-action="ResetPassword" class="admin-form">
        <div asp-validation-summary="All" class="admin-validation login-validation" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <label asp-for="Password">Mật khẩu mới</label>
        <input asp-for="Password" type="password" autocomplete="new-password" minlength="8" maxlength="256" required autofocus />
        <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="256" required />
        <button class="btn-primary" type="submit">Đổi mật khẩu</button>
    </form>
    <p><a data-account-view asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Quay lại đăng nhập</a></p>
</div>
