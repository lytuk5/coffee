@model ForgotPasswordForm
<div data-account-content data-title="Quên mật khẩu">
    @if (ViewData["ResetReference"] is string reference)
    {
        <p role="status">Nếu thông tin đúng, yêu cầu sẽ chờ quản trị viên xác minh trong 30 phút. Mã yêu cầu của bạn là <strong>@reference</strong>.</p>
        <p><a data-account-view asp-action="ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Kiểm tra trạng thái</a></p>
    }
    <form data-account-form method="post" asp-action="ForgotPassword" class="admin-form">
        <div asp-validation-summary="All" class="admin-validation login-validation" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <label asp-for="UserName">Tên đăng nhập</label>
        <input asp-for="UserName" autocomplete="username" maxlength="64" required autofocus />
        <label asp-for="PhoneNumber">Số điện thoại đã đăng ký</label>
        <input asp-for="PhoneNumber" type="tel" autocomplete="tel" inputmode="numeric"
               maxlength="10" pattern="@ExternalPhoneForm.PhonePattern" required />
        <button class="btn-primary" type="submit">Gửi yêu cầu xác minh</button>
    </form>
    <p><a data-account-view asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Quay lại đăng nhập</a></p>
</div>
