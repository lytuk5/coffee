@model ForgotPasswordForm
<div data-account-content data-title="Quên mật khẩu">
    @if (string.IsNullOrEmpty(Model.ResetToken))
    {
        @if (ViewData["ResetRequestSent"] is true)
        {
            <p role="status">Nếu tài khoản có Gmail khôi phục đã xác minh, bạn sẽ nhận được liên kết đặt lại mật khẩu.</p>
        }
        <form data-account-form method="post" asp-controller="Account" asp-action="SendResetLink" class="admin-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <label asp-for="UserName">Tên đăng nhập</label>
            <input asp-for="UserName" autocomplete="username" maxlength="64" required autofocus />
            <button class="btn-primary" type="submit">Gửi liên kết qua Gmail</button>
        </form>
    }
    else
    {
        <form data-account-form method="post" asp-controller="Account" asp-action="ForgotPassword" class="admin-form">
            <div asp-validation-summary="All" class="admin-validation login-validation" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="UserName" />
            <input type="hidden" asp-for="ResetToken" />
            <label asp-for="Password">Mật khẩu mới</label>
            <input asp-for="Password" type="password" autocomplete="new-password" minlength="8" maxlength="256" required autofocus />
            <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="256" required />
            <button class="btn-primary" type="submit">Đổi mật khẩu</button>
        </form>
        <p><a data-account-view asp-controller="Account" asp-action="ForgotPassword">Yêu cầu liên kết mới</a></p>
    }
    <p><a data-account-view asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Quay lại đăng nhập</a></p>
</div>
