@using CafeDuaHau.Services
@model IReadOnlyList<PasswordResetRequests.Request>
@{
    ViewData["Title"] = "Yêu cầu đặt lại mật khẩu";
}
<section class="view">
    <div class="view-header"><h2>Yêu cầu đặt lại mật khẩu</h2></div>
    <p>Liên hệ khách qua số điện thoại đã đăng ký, xác minh chủ tài khoản và đối chiếu mã yêu cầu trước khi duyệt.</p>
    @if (Model.Count == 0)
    {
        <p>Chưa có yêu cầu đang chờ.</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Tên đăng nhập</th><th>Số điện thoại</th><th>Mã yêu cầu</th><th>Thao tác</th></tr></thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.UserName</td>
                            <td>@request.PhoneNumber</td>
                            <td>@(request.Id.ToString("N")[..8])</td>
                            <td>
                                <form method="post" asp-action="ApprovePasswordRequest" asp-route-id="@request.Id">
                                    <button class="btn-primary" type="submit">Duyệt yêu cầu</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
