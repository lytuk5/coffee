@model AdminMenuForm
@{ var itemId = ViewData["ItemId"] as string; }
    <form method="post" enctype="multipart/form-data" asp-action="Edit" asp-route-id="@itemId" class="admin-form">
        <div asp-validation-summary="All" class="admin-validation"></div>
        <label asp-for="Name">Tên món</label>
        <input asp-for="Name" maxlength="120" required />
        <label asp-for="Description">Mô tả</label>
        <textarea asp-for="Description" maxlength="500"></textarea>
        <label asp-for="CategoryId">Danh mục</label>
        <select asp-for="CategoryId" data-category-select required>
            <option value="">Chọn danh mục</option>
            @foreach (var category in (List<Category>)ViewData["Categories"]!)
            {
                <option value="@category.Id">@category.Name</option>
            }
            <option value="@AdminMenuForm.NewCategoryOption">+ Thêm danh mục mới</option>
        </select>
        <div data-new-category hidden="@(Model.CategoryId != AdminMenuForm.NewCategoryOption)">
            <label asp-for="NewCategoryName">Tên danh mục mới</label>
            <input asp-for="NewCategoryName" maxlength="80" required disabled="@(Model.CategoryId != AdminMenuForm.NewCategoryOption)" />
        </div>
        <label asp-for="Price">Giá chung (món không có size)</label>
        <input asp-for="Price" min="1" max="1000000" />
        <details class="menu-size-prices" open="@(Model.MediumPrice.HasValue || Model.LargePrice.HasValue || Model.ExtraLargePrice.HasValue)">
            <summary>Chọn size và nhập giá</summary>
            <p>Chọn các size có bán. Size M là giá hiển thị mặc định. Khi dùng size, để trống giá chung.</p>
            @foreach (var size in new[] {
                (Label: "M", Field: "MediumPrice", Price: Model.MediumPrice),
                (Label: "L", Field: "LargePrice", Price: Model.LargePrice),
                (Label: "XL", Field: "ExtraLargePrice", Price: Model.ExtraLargePrice) })
            {
                <div class="menu-size-price">
                    <label><input type="checkbox" data-size-price-toggle checked="@size.Price.HasValue" /> Size @size.Label</label>
                    <div data-size-price-field hidden="@(!size.Price.HasValue)">
                        <label for="@size.Field">Giá size @size.Label (đ)</label>
                        <input type="number" id="@size.Field" name="@size.Field" value="@size.Price"
                               min="1" max="1000000" required disabled="@(!size.Price.HasValue)" />
                    </div>
                </div>
            }
        </details>
        <label asp-for="Photos">Thêm ảnh món</label>
        <input asp-for="Photos" type="file" accept="image/jpeg,image/png,image/webp" multiple />
        <p>JPG, PNG hoặc WebP, tối đa 5 MB mỗi ảnh. Ảnh đầu tiên được dùng làm ảnh bìa.</p>
        <div class="admin-actions">
            <button class="btn-primary">Lưu món</button>
            @if (ViewData["MenuDialog"] is true)
            {
                <button type="button" class="btn-secondary" data-close-menu-dialog>Hủy</button>
            }
            else
            {
                <a class="btn-secondary" asp-action="Index">Quay lại</a>
            }
        </div>
    </form>
