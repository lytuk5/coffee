@using CafeDuaHau.Data
@model List<MenuItem>
@{
    ViewData["Title"] = "Quản lý thực đơn";
}

<section class="view coffee-admin">
    <div class="view-header">
        <h2>Quản lý thực đơn</h2>
        <a asp-controller="Account" asp-action="PasswordRequests" class="btn-secondary">Yêu cầu đặt lại mật khẩu</a>
    </div>
    <div class="coffee-admin-toolbar">
        <div class="admin-actions">
            <a asp-action="Edit" class="btn-primary" data-add-menu>+ Thêm món</a>
            <button type="button" class="btn-secondary" aria-haspopup="dialog"
                    onclick="document.getElementById('stock-dialog').showModal()">Quản lý tồn kho</button>
        </div>
        <form method="get" asp-action="Index" class="coffee-admin-filters">
            <input name="q" value="@ViewData["Keyword"]" placeholder="Tìm kiếm món ăn..." aria-label="Tìm món" />
            <select name="category" aria-label="Danh mục">
                <option value="">Tất cả danh mục</option>
                @foreach (var category in MenuData.Categories)
                {
                    <option value="@category.Id" selected="@Equals(ViewData["Category"], category.Id)">@category.Name</option>
                }
            </select>
            <button type="submit" class="btn-secondary">Tìm</button>
        </form>
    </div>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr><th>Món</th><th>Giá</th><th>Trạng thái</th><th>Khuyến mãi</th><th>Thao tác</th></tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5">Không tìm thấy món phù hợp.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.HasSizes ? string.Join(" / ", item.Sizes.OrderByDescending(size => size.Label).Select(size => $"{size.Label} {Money.Format(size.Price)}")) : Money.Format(item.Price))</td>
                    <td>
                        <span class="@(item.IsSoldOut ? "coffee-stock-out" : "coffee-stock-in")">@(item.IsSoldOut ? "Hết hàng" : "Còn hàng")</span>
                    </td>
                    <td>
                        <button class="availability-switch hot-switch" type="button" role="switch" aria-haspopup="dialog"
                                aria-checked="@(item.IsHot || item.DiscountPercent.HasValue ? "true" : "false")"
                                aria-label="Khuyến mãi cho @item.Name"
                                data-promotion data-id="@item.Id" data-name="@item.Name"
                                data-hot="@(item.IsHot ? "true" : "false")" data-discount="@item.DiscountPercent"></button>
                    </td>
                    <td>
                        <div class="admin-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-secondary">Sửa</a>
                            <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id" asp-fragment="reviews" class="btn-secondary">Đánh giá</a>
                            <form method="post" asp-action="Delete" asp-route-id="@item.Id"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa món này?')">
                                <button class="btn-secondary">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @{
        var currentPage = (int)(ViewData["Page"] ?? 1);
        var total = (int)(ViewData["Total"] ?? 0);
        var pageCount = (int)(ViewData["PageCount"] ?? 1);
        var first = total == 0 ? 0 : (currentPage - 1) * 10 + 1;
    }
    <div class="coffee-admin-pagination">
        <span>Hiển thị @first–@(total == 0 ? 0 : first + Model.Count - 1) trên @total mục</span>
        @if (pageCount > 1)
        {
            <nav aria-label="Phân trang thực đơn">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)"
                       asp-route-q="@ViewData["Keyword"]" asp-route-category="@ViewData["Category"]">‹ Trang trước</a>
                }
                else
                {
                    <span aria-disabled="true">‹ Trang trước</span>
                }
                @for (var number = 1; number <= pageCount; number++)
                {
                    <a asp-action="Index" asp-route-page="@number" asp-route-q="@ViewData["Keyword"]"
                       asp-route-category="@ViewData["Category"]"
                       aria-current="@(number == currentPage ? "page" : null)">@number</a>
                }
                @if (currentPage < pageCount)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)"
                       asp-route-q="@ViewData["Keyword"]" asp-route-category="@ViewData["Category"]">Trang sau ›</a>
                }
                else
                {
                    <span aria-disabled="true">Trang sau ›</span>
                }
            </nav>
        }
    </div>
</section>


<dialog id="stock-dialog" class="login-dialog" aria-labelledby="stock-title">
    <div class="login-dialog-heading">
        <h2 id="stock-title">Quản lý tồn kho</h2>
        <form method="dialog">
            <button class="login-dialog-close" aria-label="Đóng">×</button>
        </form>
    </div>
    @if (TempData["StockMessage"] is string stockMessage)
    {
        <p role="status">@stockMessage</p>
    }
    @foreach (var item in (List<MenuItem>)ViewData["StockItems"]!)
    {
        <form method="post" asp-action="SetStock" class="stock-row">
            <input type="hidden" name="id" value="@item.Id" />
            <input type="hidden" name="originalQuantity" value="@item.StockQuantity" />
            <label for="stock-@item.Id">@item.Name</label>
            <input id="stock-@item.Id" type="number" name="quantity" min="0" step="1" required
                   value="@item.StockQuantity" placeholder="Chưa nhập" />
            <button class="btn-secondary" type="submit" aria-label="Lưu tồn kho @item.Name">Lưu</button>
        </form>
    }
</dialog>

<dialog id="promotion-dialog" class="login-dialog" aria-labelledby="promotion-title">
    <div class="login-dialog-heading">
        <h2 id="promotion-title">Khuyến mãi</h2>
        <button type="button" class="login-dialog-close" data-promotion-close aria-label="Đóng">×</button>
    </div>
    <form method="post" asp-action="SetPromotion" class="admin-form">
        <input type="hidden" name="id" />
        <label><input type="checkbox" name="isHot" value="true" /> Gắn nhãn HOT</label>
        <label><input type="checkbox" name="hasDiscount" value="true" /> Giảm giá khuyến mãi</label>
        <div data-promotion-discount hidden>
            <label for="discount-percent">Mức giảm (%)</label>
            <input id="discount-percent" name="discountPercent" type="number" min="1" max="100" step="1" />
        </div>
        <button class="btn-primary" type="submit">Lưu</button>
    </form>
</dialog>

<dialog class="login-dialog menu-edit-dialog" data-menu-dialog aria-labelledby="add-menu-title">
    <div class="login-dialog-heading">
        <h2 id="add-menu-title">Thêm món</h2>
        <button type="button" class="login-dialog-close" data-close-menu-dialog aria-label="Đóng">×</button>
    </div>
    <p data-menu-dialog-error role="alert" hidden></p>
    <div data-menu-dialog-content></div>
</dialog>
@section Scripts {
    <script>
        if (window.location.hash === '#stock-dialog') {
            history.replaceState(null, '', window.location.pathname + window.location.search);
            document.getElementById('stock-dialog').showModal();
        }
    </script>
    <script src="~/js/admin-menu.js" asp-append-version="true"></script>
}