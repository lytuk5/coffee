@model List<Order>
@{
    ViewData["Title"] = "Đơn của tôi";
    var reviewableItems = (HashSet<string>)ViewData["ReviewableItems"]!;
}

<section class="view view-tracking">
    <div class="view-header"><h2>Đơn hàng của tôi</h2></div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">📦</div>
            <p>Bạn chưa có đơn hàng nào.</p>
            <a class="btn-primary" style="margin-top:16px;" asp-controller="Menu" asp-action="Index">Đặt món ngay</a>
        </div>
    }
    else
    {
        <div class="orders-list">
            @foreach (var order in Model)
            {
                var isPending = order.Status == OrderStatus.Pending;

                <div class="order-card">
                    <div class="order-card-header">
                        <span class="order-id">Đơn #@order.Id.Substring(order.Id.Length - 6).ToUpper()</span>
                        <span class="order-status-badge status-@order.Status.ToString().ToLowerInvariant()">@order.Status.Label()</span>
                    </div>

                    <partial name="_OrderDetails" model="order" />

                    <div class="order-followup">
                        <form method="post" asp-action="Reorder" asp-route-id="@order.Id">
                            <button type="submit" class="btn-secondary">Đặt lại</button>
                        </form>
                        @if (order.Status == OrderStatus.Delivered)
                        {
                            var reviewItems = order.Items.Where(item => reviewableItems.Contains(item.ItemId))
                                .DistinctBy(item => item.ItemId).ToList();
                            @if (reviewItems.Count > 0)
                            {
                                <details class="order-review">
                                    <summary class="btn-secondary">Đánh giá món</summary>
                                    @foreach (var item in reviewItems)
                                    {
                                        var ratingId = $"review-{order.Id}-{item.ItemId}";
                                        <form method="post" asp-controller="Menu" asp-action="Review" asp-route-id="@item.ItemId"
                                              asp-route-fromOrders="true" class="order-review-form">
                                            <fieldset>
                                                <legend>@item.Name</legend>
                                                <div class="order-rating">
                                                    @for (var star = 1; star <= 5; star++)
                                                    {
                                                        <label>
                                                            <input type="radio" name="Rating" value="@star" aria-label="@star sao" required />
                                                            <span aria-hidden="true">★</span>
                                                        </label>
                                                    }
                                                </div>
                                                <label for="@ratingId">Nhận xét</label>
                                                <textarea id="@ratingId" name="Comment" rows="3" maxlength="1000" required></textarea>
                                                <button type="submit" class="btn-primary">Gửi đánh giá</button>
                                            </fieldset>
                                        </form>
                                    }
                                </details>
                            }
                        }
                    </div>

                    @if (isPending)
                    {
                        <form method="post" asp-action="Cancel" class="cancel-order-form">
                            <input type="hidden" name="id" value="@order.Id" />
                            <button type="submit" class="btn-secondary btn-block"
                                    style="margin-top:10px; color:var(--color-danger); border-color:var(--color-danger);"
                                    data-confirm="Bạn có chắc chắn muốn hủy đơn hàng này? Hành động này không thể hoàn tác.">
                                Hủy đơn hàng
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</section>
